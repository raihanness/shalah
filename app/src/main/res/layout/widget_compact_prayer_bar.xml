<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compact_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="7dp"
    android:paddingTop="4dp"
    android:paddingEnd="7dp"
    android:paddingBottom="4dp">

    <!-- Left Brand & Progress Badge -->
    <LinearLayout
        android:id="@+id/compact_widget_header"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/iv_compact_brand_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_mosque" />

        <TextView
            android:id="@+id/tv_compact_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:text="0 / 5"
            android:textColor="#18181B"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Vertical separator line (using FrameLayout which is fully supported in RemoteViews) -->
    <FrameLayout
        android:id="@+id/compact_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#E4E4E7" />

    <!-- 5 Daily Prayer Buttons Bar -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="2dp">

        <!-- 1. Subuh -->
        <LinearLayout
            android:id="@+id/btn_compact_fajr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_prayer_btn_pending"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/iv_compact_fajr_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@string/fajr"
                android:src="@drawable/ic_prayer_fajr" />

            <TextView
                android:id="@+id/tv_compact_fajr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:text="SUB"
                android:textColor="#18181B"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_compact_fajr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:fontFamily="sans-serif-medium"
                android:text="04.31"
                android:textColor="@color/widget_time_pending"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- 2. Dzuhur -->
        <LinearLayout
            android:id="@+id/btn_compact_dhuhr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_prayer_btn_pending"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/iv_compact_dhuhr_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@string/dhuhr"
                android:src="@drawable/ic_prayer_dhuhr" />

            <TextView
                android:id="@+id/tv_compact_dhuhr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:text="DZU"
                android:textColor="#18181B"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_compact_dhuhr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:fontFamily="sans-serif-medium"
                android:text="11.50"
                android:textColor="@color/widget_time_pending"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- 3. Ashar -->
        <LinearLayout
            android:id="@+id/btn_compact_asr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_prayer_btn_pending"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/iv_compact_asr_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@string/asr"
                android:src="@drawable/ic_prayer_asr" />

            <TextView
                android:id="@+id/tv_compact_asr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:text="ASH"
                android:textColor="#18181B"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_compact_asr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:fontFamily="sans-serif-medium"
                android:text="15.05"
                android:textColor="@color/widget_time_pending"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- 4. Maghrib -->
        <LinearLayout
            android:id="@+id/btn_compact_maghrib"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_prayer_btn_pending"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/iv_compact_maghrib_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@string/maghrib"
                android:src="@drawable/ic_prayer_maghrib" />

            <TextView
                android:id="@+id/tv_compact_maghrib_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:text="MAG"
                android:textColor="#18181B"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_compact_maghrib_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:fontFamily="sans-serif-medium"
                android:text="17.52"
                android:textColor="@color/widget_time_pending"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- 5. Isya -->
        <LinearLayout
            android:id="@+id/btn_compact_isha"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_prayer_btn_pending"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/iv_compact_isha_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@string/isha"
                android:src="@drawable/ic_prayer_isha" />

            <TextView
                android:id="@+id/tv_compact_isha_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:text="ISY"
                android:textColor="#18181B"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_compact_isha_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:fontFamily="sans-serif-medium"
                android:text="19.01"
                android:textColor="@color/widget_time_pending"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
